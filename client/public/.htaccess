<IfModule mod_headers.c>
    # 1. HSTS (Strict-Transport-Security) - HTTPS only in production
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # 2. CSP (Content-Security-Policy) - Locked to production API and self
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://sangianapi.celworld.org; connect-src 'self' https://sangianapi.celworld.org; media-src 'self' data: blob: https://sangianapi.celworld.org; frame-src 'none'; object-src 'none';"

    # 3. Prevent MIME Sniffing
    Header set X-Content-Type-Options "nosniff"

    # 4. Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # 5. Restrict Permissions
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>
